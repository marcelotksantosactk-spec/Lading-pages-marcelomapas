 const state = { idx: 0, drag: false, startX: 0, startIdx: 0 };
 carousels[id] = state;
 function pages() { return Math.ceil(total / cols()); }
 function go(n) {
 const p = pages();
 state.idx = ((n % p) + p) % p;
 const pct = state.idx * (100 / cols()) * cols() / 1;
 const slideW = 100 / cols();
 track.style.transform = `translateX(-${state.idx * slideW * cols()}%)`;
 dots.querySelectorAll('.c-dot').forEach((d,i) => d.classList.toggle('active', i === state.idx));
 }
 dots.innerHTML = '';
 for (let i = 0; i < Math.ceil(total / cols()); i++) {
 const d = document.createElement('div');
 d.className = 'c-dot' + (i === 0 ? ' active' : '');
 d.onclick = () => go(i);
 dots.appendChild(d);
 }
 state.auto = setInterval(() => go(state.idx + 1), 4000);
 window.addEventListener('resize', () => {
 dots.innerHTML = '';
 for (let i = 0; i < Math.ceil(total / cols()); i++) {
 const d = document.createElement('div');
 d.className = 'c-dot' + (i === 0 ? ' active' : '');
 d.onclick = () => go(i);
 dots.appendChild(d);
 }
 go(0);
 });
 state.go = go;
}
function moveCarousel(id, dir) {
 const s = carousels[id];
 if (!s) return;
 clearInterval(s.auto);
 s.go(s.idx + dir);
 s.auto = setInterval(() => s.go(s.idx + 1), 4000);
}
const dragState = {};
function startDrag(e, id) {
 const s = carousels[id];
 if (!s) return;
 clearInterval(s.auto);
 const track = document.getElementById(id).querySelector('.carousel-track');
 track.classList.add('dragging');
 dragState[id] = {
 active: true,
 startX: (e.touches ? e.touches[0].clientX : e.clientX),
 startIdx: s.idx
 };
}
function onDrag(e, id) {
 const d = dragState[id];
 if (!d || !d.active) return;
 e.preventDefault();
 const x = (e.touches ? e.touches[0].clientX : e.clientX);
 const diff = d.startX - x;
 const slideW = document.getElementById(id).querySelector('.carousel-slide').offsetWidth;
 const cols = window.innerWidth >= 768 ? 4 : 1;
 const offset = d.startIdx * slideW * cols + diff;
 document.getElementById(id).querySelector('.carousel-track').style.transform = `translateX(-${offset}px)`;
}
function endDrag(id) {
 const d = dragState[id];
 if (!d || !d.active) return;
 d.active = false;
 const track = document.getElementById(id).querySelector('.carousel-track');
 track.classList.remove('dragging');
 const matrix = new WebKitCSSMatrix(track.style.transform);
 const slideW = document.getElementById(id).querySelector('.carousel-slide').offsetWidth;
 const cols = window.innerWidth >= 768 ? 4 : 1;
 const currentPx = -matrix.m41;
 const movedSlides = Math.round(currentPx / slideW);
 const s = carousels[id];
 s.go(Math.floor(movedSlides / cols));
 s.auto = setInterval(() => s.go(s.idx + 1), 4000);
}
window.addEventListener('load', () => {
 initCarousel('test-carousel');
 initCarousel('gal-carousel');
});
