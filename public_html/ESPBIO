<script>
// COUNTDOWN
(function(){
  var end = Date.now() + 15*60*1000;
  function tick(){
    var r = Math.max(0, end - Date.now());
    var m = Math.floor(r/60000);
    var s = Math.floor((r%60000)/1000);
    document.getElementById('timer').textContent = String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
    if(r > 0) setTimeout(tick, 1000);
  }
  tick();
})();

// ACCORDION
function toggle(btn){
  var mod = btn.parentElement;
  var isOpen = mod.classList.contains('open');
  document.querySelectorAll('.mod.open').forEach(function(m){ m.classList.remove('open'); });
  if(!isOpen) mod.classList.add('open');
}

// TOAST
var names = ['María de Colombia','Andrea de Argentina','Jorge de México','Lucía de Chile','Rosa de Perú','Diego de Venezuela','Paula de Ecuador','Carlos de Bolivia'];
var t = document.getElementById('toast');
var idx = 0;
function showToast(){
  document.getElementById('toast-name').textContent = names[idx % names.length];
  idx++;
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 3800);
}
setTimeout(showToast, 4000);
setInterval(showToast, 18000);
</script>



<script>
// Scroll reveal
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
}, { threshold: 0.12 });
revealEls.forEach(el => io.observe(el));
</script>

