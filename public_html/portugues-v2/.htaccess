# Pagina em teste: o HTML nao fica guardado no navegador, para cada ajuste aparecer na hora.
# As imagens continuam com o cache longo do site (trocar imagem = nome novo).
<IfModule mod_expires.c>
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
