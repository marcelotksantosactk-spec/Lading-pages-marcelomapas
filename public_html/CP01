  function open(name){
    var d=SUM[name]; if(!d) return;
    titleEl.textContent=name;
    pagesEl.textContent=d.pages;
    listEl.innerHTML='';
    d.content.split('\u00b7').map(function(t){return t.trim();}).filter(Boolean).forEach(function(t){
      var li=document.createElement('li');
      li.style.cssText='display:flex;gap:10px;align-items:flex-start;background:var(--card,#1a1a1a);border:1px solid var(--border,rgba(255,255,255,.08));border-radius:10px;padding:10px 14px;font-size:.9rem;color:#e5e5e5;';
      li.innerHTML='<span style="color:var(--gold,#ff910c);font-weight:700;flex-shrink:0;">&#8226;</span><span>'+t+'</span>';
      listEl.appendChild(li);
    });
    modal.style.display='flex';
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';
    requestAnimationFrame(function(){ panel.style.transform='translateY(0)'; });
  }
  function close(){
    panel.style.transform='translateY(100%)';
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow='';
    setTimeout(function(){ modal.style.display='none'; },300);
  }
  document.querySelectorAll('[data-disc]').forEach(function(btn){
    btn.addEventListener('click',function(e){ e.preventDefault(); open(btn.getAttribute('data-disc')); });
  });
  overlay.addEventListener('click',close);
  closeBtn.addEventListener('click',close);
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
})();
