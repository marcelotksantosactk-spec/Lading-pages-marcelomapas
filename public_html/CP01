<script>
(function(){
  var el=document.getElementById('topCountdown');
  if(!el) return;
  // contagem regressiva de 15 minutos a partir do carregamento
  var end=Date.now()+15*60*1000;
  function tick(){
    var diff=end-Date.now();
    if(diff<0) diff=0;
    var mm=Math.floor(diff/6e4),
        ss=Math.floor(diff%6e4/1e3),
        p=function(n){return (n<10?'0':'')+n;};
    el.textContent=p(mm)+':'+p(ss);
  }
  tick(); setInterval(tick,1000);
})();
</script>
