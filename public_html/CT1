<style id="paleta-semantica">
/* =====================================================================
   PALETA SEMÂNTICA — uma cor, um significado
   âmbar  = marca / rótulo de seção      verde = ação e "incluso"
   azul   = preço final                  vermelho = urgência
   ===================================================================== */
:root{
  --ac-marca:#B45309;      /* âmbar escuro — texto sobre fundo claro (AA 4.7:1) */
  --ac-marca-viv:#FF910C;  /* laranja vivo — só gráfico / fundo escuro */
  --ac-acao:#1FA85C;
  --ac-preco:#1668E3;
  --ac-alerta:#D92D20;
  --tx-1:#101418;          /* títulos */
  --tx-2:#454C56;          /* corpo */
  --tx-3:#667080;          /* apoio (mínimo legível em branco) */
  --tx-4:#9AA3AE;          /* riscado / decorativo, nunca informação */
}

/* ---- 1. rótulos de seção em fundo claro: laranja vivo -> âmbar legível ---- */
.el-hl-kicker,
.sm2-h-t,
.au-kicker{color:var(--ac-marca)!important}
section:not(.sec-escura) .el-kicker{color:var(--ac-marca)!important}
section:not(.sec-escura) .el-h2 em{color:var(--ac-marca)!important}
/* o kicker verde da garantia é ação, mantém */
.el-guarantee .el-kicker{color:var(--ac-acao)!important}

/* ---- 2. verde = tudo que significa "incluso / confirmado" ---- */
.of-chk,
.sm2-ck,
.bn-lista svg,
.el-hl-check{color:var(--ac-acao)!important}

/* ---- 3. azul fica exclusivo do preço final ---- */
.of-tag{color:var(--tx-3)!important}
.of-val,.of-val small{color:var(--ac-preco)!important}
.of-lista .val{color:var(--tx-2)!important;font-weight:700}
.of-somado .val,.of-somado s,.bn-valor s{color:var(--tx-4)!important}

/* ---- 4. números de marca em fundo claro ---- */
.tm-nota span,.st-num .p{color:var(--ac-marca)!important}
.au-chip svg,.dp-selo--pag{color:var(--ac-marca)!important}

/* ---- 5. escala de cinzas: nada abaixo de 4.5:1 em texto ---- */
.rd-nota,
.of-lista .pag,
.of-obs,
.of-pay p:not(.of-urgencia),
.amt-hint,
.tm-hint,
.sm-pe{color:var(--tx-3)!important}
.mp-head p,.cmp-head p,.mp-item p,.of-desc,.sm-head p,
.el-guarantee p,.el-hl-card>p{color:var(--tx-2)!important}
.sm2-h-n{color:var(--tx-3)!important}

/* ---- 6. vermelho só para urgência ---- */
.of-pay p.of-urgencia,
.of-pay p.of-urgencia span,
.of-pay p.of-urgencia svg{color:#9F1D17!important}
.of-pay p.of-urgencia b{color:#B42318!important}

