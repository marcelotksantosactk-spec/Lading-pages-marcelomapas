.of-card--best{border-color:var(--ac-acao)!important}

/* ---- 8. legendas e âncoras de preço ---- */
.amt-rot span{color:#6E6A5E!important}
.of-soma b,.of-soma span{color:#6B7280!important}

/* ---- 9. bloco de garantia em preto (o selo tem fundo preto e destacava
